# Instagram Graph API — credenciais para publish_instagram.js
# Copie para .env (gitignored) e preencha. NUNCA commite o .env real.

# ID numérico do Instagram Business Account
IG_USER_ID=

# Token long-lived com escopo instagram_content_publish
IG_ACCESS_TOKEN=

# Base PÚBLICA onde as PNGs do post estão hospedadas
# (a Graph API exige image_url pública — arquivo local não funciona)
IG_IMAGE_BASE_URL=

# Versão da API (opcional; default v22.0)
IG_API_VERSION=v22.0
