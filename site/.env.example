# Tracking / analytics — todos opcionais.
# Preencha só os que for usar; vazio = script não é injetado.

# Google Analytics 4
NEXT_PUBLIC_GA_ID=

# Meta (Facebook/Instagram) Pixel — necessário ao rodar tráfego pago
NEXT_PUBLIC_META_PIXEL_ID=

# Microsoft Clarity — heatmap + gravação de sessão
NEXT_PUBLIC_CLARITY_ID=

# Destino do CTA primário (WhatsApp qualificado). Ex: https://wa.me/55SEUNUMERO?text=...
# Enquanto vazio, usa um placeholder — PREENCHER com o número real antes do deploy.
NEXT_PUBLIC_WHATSAPP_URL=

# ── Orquestração + Dashboard (Onda 5) ──────────────────────────
# Secret que a Vercel envia no header Authorization do cron. Gere: openssl rand -hex 32
CRON_SECRET=

# Chave da Claude API usada pelo orquestrador (cron + dispatch do dashboard)
CLAUDE_API_KEY=

# Token de acesso ao dashboard /admin. Gere: openssl rand -hex 32
DASHBOARD_TOKEN=
